# Copy this file to .env.local and fill in the real connection string.
# .env.local is gitignored — NEVER commit real credentials (this repo is public).
#
# Hosted Postgres (Neon) connection string. Get it from the person who set up the DB,
# or from the Neon dashboard (Project → Connection Details). Format:
DATABASE_URL=postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require
